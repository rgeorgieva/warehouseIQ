# n8n self-hosted base URL (where your webhook nodes live)
# Examples:
#   http://localhost:5678/webhook
#   https://n8n.example.com/webhook
N8N_BASE_URL=http://localhost:5678/webhook

# Shared secret sent to every n8n webhook as `x-webhook-secret`.
# Must match the value validated inside the workflow's first IF node.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-string

# Optional: name shown in the UI top bar
NEXT_PUBLIC_APP_NAME=warehouseIQ
